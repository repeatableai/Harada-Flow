generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DEPARTMENT_ADMIN
  COMPANY_ADMIN
  ADMIN           // Kept for backwards compatibility (maps to COMPANY_ADMIN)
  SUPER_ADMIN
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String?   // Null for email-verified users (regular users)
  name           String?
  jobTitle       String?   @map("job_title")
  role           UserRole  @default(USER)
  isPermanent    Boolean   @default(false) @map("is_permanent")
  isActive       Boolean   @default(true) @map("is_active")
  isTrialUser       Boolean   @default(false) @map("is_trial_user")    // Users from request access
  deliverablesUsed  Int       @default(0) @map("deliverables_used")   // Track saved deliverables for trial users
  deliverablesLimit Int?      @map("deliverables_limit")              // Max outputs allowed (null = unlimited)
  sessionExpiry  DateTime? @map("session_expiry")

  // Organization/Department associations
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  departmentId   String?       @map("department_id")
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastLoginAt    DateTime? @map("last_login_at")

  companies            Company[]
  sessions             Session[]
  timeStudies          TimeStudy[]
  knowledgeFiles       KnowledgeFile[]
  passwordResetTokens  PasswordResetToken[]
  cuiScanLogs          CuiScanLog[]

  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@index([departmentId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model Company {
  id                 String   @id @default(uuid())
  jobTitle           String   @map("job_title")
  industry           String
  companySize        String   @map("company_size")
  companyUrl         String?  @map("company_url")
  productivityMatrix Json?    @map("productivity_matrix")
  performanceMatrix  Json?    @map("performance_matrix")

  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy          String   @map("created_by") // User email for backwards compatibility

  // Organization association
  organizationId     String?       @map("organization_id")
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  savedPrompts       SavedPrompt[]
  timeStudies        TimeStudy[]
  knowledgeFiles     KnowledgeFile[]

  @@index([userId])
  @@index([createdBy])
  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@map("companies")
}

model SavedPrompt {
  id              String   @id @default(uuid())
  deliverableName String   @map("deliverable_name")
  deliverableType String   @map("deliverable_type")  // 'productivity' | 'performance'
  columnName      String?  @map("column_name")
  overview        String   @db.Text
  prompts         Json     // Array of {step, title, description, prompt}

  // Custom deliverable tracking
  isCustom        Boolean  @default(false) @map("is_custom")
  customInput     String?  @map("custom_input") @db.Text  // Original user input for custom deliverables

  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([createdAt(sort: Desc)])
  @@map("saved_prompts")
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, code])
  @@index([email])
  @@index([expiresAt])
  @@map("verification_codes")
}

model UsedEmail {
  id     String   @id @default(uuid())
  email  String   @unique
  usedAt DateTime @default(now()) @map("used_at")

  @@map("used_emails")
}

model TimeStudy {
  id                    String   @id @default(uuid())

  // Operation type: 'productivity_matrix' | 'performance_matrix' | 'deliverable_prompts'
  operationType         String   @map("operation_type")
  operationName         String?  @map("operation_name")  // e.g., deliverable name or "Software Engineer - Tech"

  // Time measurements (in minutes)
  baselineManualMinutes Int      @map("baseline_manual_minutes")  // Auto-estimated
  actualMinutes         Float    @map("actual_minutes")           // Measured (float for precision)
  minutesSaved          Float    @map("minutes_saved")            // Calculated
  percentReduction      Float    @map("percent_reduction")        // Calculated

  // Context
  companyId             String   @map("company_id")
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                String   @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([userId])
  @@index([operationType])
  @@index([createdAt(sort: Desc)])
  @@map("time_studies")
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique  // URL-friendly identifier
  industry    String?      // Company industry (e.g., "Technology", "Healthcare")
  companySize String?      @map("company_size")  // Company size (e.g., "startup", "medium", "enterprise")
  website     String?      // Company website URL
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  departments    Department[]
  users          User[]
  companies      Company[]
  knowledgeFiles KnowledgeFile[]
  cuiScanLogs    CuiScanLog[]

  @@index([slug])
  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  name           String
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users          User[]

  @@unique([organizationId, name])  // Unique dept name per org
  @@index([organizationId])
  @@map("departments")
}

model KnowledgeFile {
  id             String       @id @default(uuid())
  filename       String       // Stored filename (UUID-based)
  originalName   String       @map("original_name")
  mimeType       String       @map("mime_type")
  size           Int          // File size in bytes

  // Uploader info
  uploaderId     String       @map("uploader_id")
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  // Scope: 'self', 'departments', 'company', 'system', 'users'
  scope          String       @default("self")

  // For 'departments' scope - which departments can access
  departmentIds  String[]     @default([]) @map("department_ids")

  // For 'users' scope - which specific users can access
  sharedUserIds  String[]     @default([]) @map("shared_user_ids")

  // Organization this file belongs to
  organizationId String?      @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Optional link to Company (role session) this file was uploaded for
  companyId      String?      @map("company_id")
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Metadata
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([uploaderId])
  @@index([organizationId])
  @@index([companyId])
  @@index([scope])
  @@map("knowledge_files")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // 'reset' or 'invite'
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model AccessRequest {
  id           String    @id @default(uuid())
  name         String
  company      String
  email        String
  jobTitle     String    @map("job_title")
  passwordHash String    @map("password_hash")
  status       String    @default("pending")  // 'pending', 'approved', 'rejected'
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedBy   String?   @map("reviewed_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("access_requests")
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")  // For scoping to company
  departmentId   String?  @map("department_id")    // For scoping to department
  activityType   String   @map("activity_type")    // 'file_upload', 'file_access', 'session_load'
  resourceType   String   @map("resource_type")    // 'knowledge_file', 'session'
  resourceId     String?  @map("resource_id")
  metadata       Json?                             // Includes: fileName, fileType, userName, sessionName
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([activityType])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model CuiScanLog {
  id              String    @id @default(uuid())
  scanId          String    @unique @map("scan_id")
  organizationId  String?   @map("organization_id")
  userId          String    @map("user_id")
  filename        String?
  fileType        String?   @map("file_type")
  fileSizeBytes   Int?      @map("file_size_bytes")
  verdict         String    // BLOCK, WARN, PASS
  findingsCount   Int       @default(0) @map("findings_count")
  findingsSummary Json?     @map("findings_summary")
  userConfirmed   Boolean   @default(false) @map("user_confirmed")
  confirmedAt     DateTime? @map("confirmed_at")
  ipAddress       String?   @map("ip_address")
  scannedAt       DateTime  @default(now()) @map("scanned_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([verdict])
  @@index([scannedAt(sort: Desc)])
  @@map("cui_scan_audit_log")
}
