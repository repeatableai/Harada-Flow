{
  "name": "role-deliverable-matrices-server",
  "version": "1.0.0",
  "description": "Backend API for Role Deliverable Matrices application",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate && prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node seed.js",
    "db:seed:business": "node seed-business-data.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0-rc.12",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "resend": "^6.4.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  }
}
